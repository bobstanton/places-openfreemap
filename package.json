{
  "name": "places-openfreemap",
  "version": "0.0.1",
  "description": "Map provider for Places using OpenFreeMap, with free vector maps and POI discovery.",
  "main": "main.js",
  "scripts": {
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "rename": "node -e \"require('fs').rename('main.css', 'styles.css', () => { })\"",
    "dev": "node esbuild.config.mjs && npm run rename",
    "build": "node esbuild.config.mjs production && npm run rename",
    "typecheck": "tsc --noEmit --pretty false --skipLibCheck",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "watch": "node esbuild.config.mjs watch"
  },
  "keywords": [],
  "author": "Bob Stanton",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.1",
    "obsidian": "^1.13.1",
    "tslib": "2.8.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "maplibre-gl": "^6.0.0",
    "places-maplibre-base": "git+https://github.com/bobstanton/places-maplibre-base.git#0.0.1",
    "places-shared": "git+https://github.com/bobstanton/places-shared.git#0.0.1"
  },
  "overrides": {
    "typescript": "6.0.3"
  }
}
